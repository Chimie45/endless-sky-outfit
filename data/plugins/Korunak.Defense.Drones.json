als extra shield emitters.","variants":{"Container Transport":{"Proton Turret":1,"Quad Blaster Turret":2,"Heavy Anti-Missile Turret":2,"Fission Reactor":1,"LP036a Battery Pack":1,"LP072a Battery Pack":1,"Water Coolant System":2,"S-970 Regenerator":1,"Laser Rifle":18,"Interference Plating":3,"A250 Atomic Thruster":1,"A375 Atomic Steering":1,"Scram Drive":1}},"soldAt":[],"obtainable":true,"source":"Korunak.Defense.Drones"},"Defense Drone":{"name":"Defense Drone","displayName":"Defense Drone","faction":"human","category":"Drone","sprite":"plugins/Korunak.Defense.Drones/ship/defense drone","thumbnail":"plugins/Korunak.Defense.Drones/thumbnail/defense drone","attributes":{"category":"Drone","cost":22000.0,"hull":450.0,"automaton":1.0,"mass":15.0,"drag":0.55,"heat dissipation":0.9,"outfit space":49.0,"weapon capacity":6.0,"engine capacity":28.0},"hardpoints":{"guns":1,"turrets":0,"engines":1,"reverseEngines":0,"bays":{}},"points":[{"t":"engine","x":0.0,"y":25.0},{"t":"gun","x":0.0,"y":-27.0}],"defaultOutfits":{"Energy Blaster":1,"KP-6 Photovoltaic Panel":3,"X1700 Ion Thruster":1,"X1200 Ion Steering":1,"LP036a Battery Pack":1},"description":"The Korunak Robotics Defense Drone series is almost as old as space exploration itself. The first models were used as surveillance probes in the Sol system, and later as reconnaissance drones when the first colonies were established. They were repurposed as expendable freighter defense vessels during the Alpha wars, and the main design hasn't changed much since. \tDrones do not come equipped with a hyperdrive. You cannot carry a drone unless you have a ship in your fleet with a drone bay.","variants":{},"soldAt":[],"obtainable":true,"source":"Korunak.Defense.Drones"},"Nock":{"name":"Nock","displayName":"Nock","faction":"human","category":"Drone","sprite":"plugins/Korunak.Defense.Drones/ship/nock","thumbnail":"plugins/Korunak.Defense.Drones/thumbnail/nock","attributes":{"category":"Drone","cost":41000.0,"shields":450.0,"hull":350.0,"automaton":1.0,"mass":23.0,"drag":0.55,"heat dissipation":0.9,"outfit space":59.0,"weapon capacity":12.0,"engine capacity":20.0},"hardpoints":{"guns":2,"turrets":0,"engines":1,"reverseEngines":0,"bays":{}},"points":[{"t":"engine","x":0.0,"y":26.0},{"t":"gun","x":0.0,"y":-28.0},{"t":"gun","x":-12.0,"y":-22.0}],"defaultOutfits":{"D14-RN Shield Generator":1,"Energy Blaster":1,"Javelin Mini Pod":1,"KP-6 Photovoltaic Panel":3,"LP036a Battery Pack":1,"X1050 Ion Engines":1},"description":"Korunak Robotics released the Nock shortly after Syndicated Shipyards its Barb fighter, although its development began almost a decade earlier. It's the first human drone with a shield matrix, making a step away from seeing drones as expendables. For a higher price one gets more sustainability, and saves money in the long-term. \tDrones do not come equipped with a hyperdrive. You cannot carry a drone unless you have a ship in your fleet with a drone bay.","variants":{},"soldAt":[],"obtainable":true,"source":"Korunak.Defense.Drones"},"Super Nock":{"name":"Super Nock","displayName":"Super Nock","faction":"human","category":"Drone","sprite":"plugins/Korunak.Defense.Drones/ship/super nock","thumbnail":"plugins/Korunak.Defense.Drones/thumbnail/super nock","attributes":{"category":"Drone","cost":73000.0,"shields":800.0,"hull":400.0,"automaton":1.0,"mass":30.0,"drag":0.55,"heat dissipation":0.9,"outfit space":75.0,"weapon capacity":20.0,"engine capacity":20.0},"hardpoints":{"guns":2,"turrets":0,"engines":2,"reverseEngines":0,"bays":{}},"points":[{"t":"engine","x":8.5,"y":25.0},{"t":"engine","x":-5.0,"y":25.0},{"t":"gun","x":8.5,"y":-22.0},{"t":"gun","x":-5.0,"y":-25.0}],"defaultOutfits":{"Javelin Mini Pod":1,"Javelin Storage Crate":1,"KP-6 Photovoltaic Panel":3,"LP036a Battery Pack":1,"S-270 Regenerator":1,"Supercapacitor":3,"Twin Blaster":1,"X1050 Ion Engines":1},"description":"Korunak Robotics' Super Nock drone is at eye level with any fighter sold, at that saving the costs for a life support system and the wages for a pilot. \tDrones do not come equipped with a hyperdrive. You cannot carry a drone unless you have a ship in your fleet with a drone bay.","variants":{},"soldAt":[],"obtainable":true,"source":"Korunak.Defense.Drones"}},"outfits":{},"systems":{}}